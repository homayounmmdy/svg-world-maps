{
  "name": "svg-world-maps",
  "version": "1.0.1",
  "description": "Simple, lightweight, and interactive SVG maps for JavaScript/TypeScript projects. Includes the World map and 211+ country/region maps (USA, China, Japan, Germany, Iran, Brazil, etc.) with built-in tooltips, labels, click handling, and zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/maps/optional/**/*.ts",
    "scripts/add-map.js",
    "scripts/register-map.js",
    "scripts/create-map.mjs",
    "scripts/generate-report.js"
  ],
  "bin": {
    "add-map": "./scripts/add-map.js",
    "register-map": "./scripts/register-map.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "generate-map-docs": "node scripts/docs/generate-map.js",
    "create-map": "node scripts/create-map.mjs",
    "generate-report": "node scripts/generate-report.js",
    "register-map": "node scripts/register-map.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "svg",
    "maps",
    "world-map",
    "svg-map",
    "interactive-map",
    "country-maps",
    "react-map",
    "vue-map",
